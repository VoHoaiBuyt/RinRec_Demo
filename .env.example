# ─── RinRec SmartAdvisor 360 — Environment Variables Template ─────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGO_USER=rinrec_ad
MONGO_PASS=your_password_here
MONGO_HOST=cluster0.xxxxxxx.mongodb.net
MONGO_DB_NAME=RinRec_DB
# Or provide a full connection URI (overrides above)
# MONGO_URI=mongodb+srv://user:pass@host/?retryWrites=true&w=majority

# ─── Admin Account ────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_FULLNAME=Võ Hoài Buýt
ADMIN_USER_CODE=VP8000
ADMIN_BRANCH=Chi nhánh Hội Sở

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=RinRec SmartAdvisor 360
APP_ENV=development     # development | production

# ─── Backend API (FastAPI) ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── Frontend (Streamlit) ─────────────────────────────────────────────────────
STREAMLIT_PORT=8501

# ─── Face Engine ──────────────────────────────────────────────────────────────
FACE_ENGINE_ENABLED=true
FACE_MIN_CONFIDENCE=0.55
