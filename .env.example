# ─── RinRec SmartAdvisor 360 — Environment Variables Template ─────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://rinrec_admin:your_password@cluster0.xxxxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=RinRec_DB
MONGODB_TIMEOUT_MS=5000

# Legacy vars (for backward compatibility)
MONGO_USER=rinrec_admin
MONGO_PASS=your_password_here
MONGO_HOST=cluster0.xxxxxxx.mongodb.net
MONGO_DB_NAME=RinRec_DB

# ─── JWT & Security ───────────────────────────────────────────────────────────
# IMPORTANT: Change these in production!
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_JWT_SECRET_KEY_MINIMUM_32_CHARS_12345
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_ALSO_32_CHARS_MINIMUM_67890
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption key for PII fields (email, phone, income)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_Fernet_generate_key_32_BYTES_BASE64==

# ─── Admin Account ────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_FULLNAME=TS. Trần Anh Tuấn
ADMIN_USER_CODE=VP8000
ADMIN_BRANCH=Chi nhánh Hội Sở

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=RinRec SmartAdvisor 360
APP_ENV=development     # development | production

# ─── Backend API (FastAPI) ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── Frontend (Streamlit) ─────────────────────────────────────────────────────
STREAMLIT_PORT=8501

# ─── Face Engine ──────────────────────────────────────────────────────────────
FACE_ENGINE_ENABLED=true
FACE_MIN_CONFIDENCE=0.55

# ─── Redis (Optional — for rate limiting, session storage) ────────────────────
# If not set, slowapi will use in-memory storage (lost on restart)
# REDIS_URL=redis://localhost:6379/0

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
